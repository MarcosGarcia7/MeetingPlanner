API_INTERNAL_URL=http://localhost:8080

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- Session ---
# Idle timeout in seconds; extended on each page and /api request.
SESSION_TTL=1800
# false is only for plain http://localhost, where browsers wouldn't send a Secure cookie reliably.
# Must not be false over HTTPS. If unset, it's true when NODE_ENV=production.
COOKIE_SECURE=false

# --- Time zone ---
# IANA zone (e.g. America/Chicago) for showing times to users without a profile time zone and to
# people invited by email. Used by both the API (emails, messages) and the BFF (pages). Default: UTC.
DEFAULT_TIMEZONE=UTC
