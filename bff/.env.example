API_INTERNAL_URL=http://localhost:8080

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- Session ---
# Idle timeout in seconds; extended on each page and /api request.
SESSION_TTL=1800
# false is only for plain http://localhost, where browsers wouldn't send a Secure cookie reliably.
# Must not be false over HTTPS. If unset, it's true when NODE_ENV=production.
COOKIE_SECURE=false
