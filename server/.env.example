SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meeting_planner_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

SERVER_PORT=8080

# Base URL used in email links (points at the Next.js BFF in local dev)
APP_BASE_URL=http://localhost:3000

JWT_ISSUER=http://localhost:8080

JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-secret-0123456789abcdef

JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-base64-secret-0123456789abcdef

ACCESS_TOKEN_EXPIRATION_MS=900000

REFRESH_TOKEN_EXPIRATION_MS=604800000

APP_CORS_ORIGINS=http://localhost:3000

# Email (SMTP). With EMAIL_ENABLED=false, mail is queued in email_outbox but never sent.
# Production example uses Resend: username is literally "resend", password is the API key.
EMAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=resend
MAIL_SMTP_PASSWORD=re_change-me
MAIL_FROM=MeetingPlanner <no-reply@mail.example.com>

# Scheduling / cleanup
EMAIL_DRAIN_DELAY_MS=30000
REMINDER_DELAY_MS=60000
MEETING_CLEANUP_CRON=0 0 3 * * *

REDIS_PASSWORD=change-me