# --- Server ---
SERVER_PORT=8080
# Base URL used in email links (points at the Next.js BFF in local dev)
APP_BASE_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=meeting_planner_db
# Host port published by docker-compose.dev.yml (the container itself listens on 5432)
DB_PORT=5434

# --- Redis ---
REDIS_PASSWORD=change-me

# --- JWT ---
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-secret-0123456789abcdef
JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-base64-secret-0123456789abcdef
ACCESS_TOKEN_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# --- Email ---
# Set EMAIL_ENABLED=true and SMTP credentials to enable sends.
# With EMAIL_ENABLED=false, mail is queued in email_outbox but never sent.
EMAIL_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=meetingplanner@localhost

# --- Scheduling / cleanup ---
EMAIL_DRAIN_DELAY_MS=30000
REMINDER_DELAY_MS=60000
MEETING_CLEANUP_CRON=0 0 3 * * *
