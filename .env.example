DB_USER=postgres
DB_PASSWORD=password
DB_NAME=meeting_planner_db

REDIS_PASSWORD=change-me

# --- Local development (Docker Compose with HTTPS on https://localhost) ---
APP_DOMAIN=localhost
CADDYFILE=./Caddyfile.local
APP_BASE_URL=https://localhost
JWT_ISSUER=https://localhost
# Adds docker-compose.dev.yml, which publishes Postgres (5434) and Redis (6379) on the host.
# Leave both unset in production so the database and cache stay unreachable from outside.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Production ---
# Comment out the local block above and uncomment these for production.
# Public origin users browse to; must point to the host running the stack.
# APP_DOMAIN=meetingplanner.example.com
# HTTPS origin, same as https://${APP_DOMAIN}
# JWT_ISSUER=https://meetingplanner.example.com
# Base URL used in email links (should match the public origin)
# APP_BASE_URL=https://meetingplanner.example.com

JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-secret-0123456789abcdef

JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-base64-secret-0123456789abcdef

ACCESS_TOKEN_EXPIRATION_MS=900000

REFRESH_TOKEN_EXPIRATION_MS=604800000

# Email delivery. Set EMAIL_ENABLED=true and SMTP credentials to enable sends.
EMAIL_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=meetingplanner@meetingplanner.example.com

# Scheduling / cleanup
EMAIL_DRAIN_DELAY_MS=30000
REMINDER_DELAY_MS=60000
MEETING_CLEANUP_CRON=0 0 3 * * *
