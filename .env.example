DB_USER=postgres
DB_PASSWORD=password
DB_NAME=meeting_planner_db

# Spring Boot datasource (consumed by server/src/main/resources/application.properties
# when the app is run from the repo root, e.g. the IntelliJ green button).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/meeting_planner_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

REDIS_PASSWORD=change-me

# Public origin users browse to; must point to the host running the stack.
APP_DOMAIN=meetingplanner.example.com

# HTTPS origin, same as https://${APP_DOMAIN}
JWT_ISSUER=https://meetingplanner.example.com

JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-secret-0123456789abcdef

JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-base64-secret-0123456789abcdef

ACCESS_TOKEN_EXPIRATION_MS=900000

REFRESH_TOKEN_EXPIRATION_MS=604800000

# Base URL used in email links (should match the public origin)
APP_BASE_URL=https://meetingplanner.example.com

# Email delivery. Set EMAIL_ENABLED=true and SMTP credentials to enable sends.
EMAIL_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=meetingplanner@meetingplanner.example.com
