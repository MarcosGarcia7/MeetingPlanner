DB_USER=postgres
DB_PASSWORD=password
DB_NAME=meeting_planner_db

REDIS_PASSWORD=change-me

# Public origin users browse to; must point to the host running the stack.
APP_DOMAIN=meetingplanner.example.com

# HTTPS origin, same as https://${APP_DOMAIN}
JWT_ISSUER=https://meetingplanner.example.com

JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-base64-secret-0123456789abcdef

JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-base64-secret-0123456789abcdef

ACCESS_TOKEN_EXPIRATION_MS=900000

REFRESH_TOKEN_EXPIRATION_MS=604800000
